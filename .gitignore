# Next.js / Turbopack
.next/
out/
next-env.d.ts

# Production
build/
dist/

# Dependencies
node_modules/
.pnp
.pnp.*

# Environment
.env
.env*.local
!.env.example

# Testing
coverage/

# Generated by scripts/generate-icons.mjs — regenerate, do not hand-edit
# (committed so the PWA works straight from a fresh clone)

# Agent scratch space — throwaway typecheck/probe harnesses
.smoke-tmp/
smoke*.ts
*.diag.json
*.smoke.json

# Misc
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel
.env*

# TypeScript
*.tsbuildinfo

# Editors
.idea/
.vscode/

# Build/typecheck logs
.build-log.txt
.tsc-errors.txt

# Local dev/probe logs
.dev.log
.next/
*.local.log

# Compiled JS emitted next to TS sources by ad-hoc transpile runs
lib/**/*.js
!lib/**/*.d.ts

# Tooling output
.lint.json
.tsc-errors.txt
*.log

# temporary tooling output
.lint-report.json

# screenshots written by the headless-Chrome checks
tmp/

# `vercel link` appends `.vercel` and `.env*` here. Both are correct, and both
# are duplicates of rules already above -- but the `.env*` one lands AFTER
# `!.env.example`, and in gitignore the last matching rule wins. `.env.example`
# survives today only because it is already tracked, which is an accident of
# history rather than a guarantee. Re-stating the negation below means the
# template stays committable even on a fresh clone.
!.env.example
