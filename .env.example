=-─────────────────────────────────────────────────────────────────────────────
#  Balu Tools — environment
#
#  Every variable here is OPTIONAL. With none of them set the site runs
#  completely: every browser-based tool works, and the tools that need a
#  provider render an explicit "Setup required" panel naming the variable
#  it needs.
#
#  SECURITY: never prefix a secret with NEXT_PUBLIC_. Anything with that
#  prefix is inlined into the JavaScript bundle and readable by anyone
#  who opens the page.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Used for metadata, sitemap.xml, robots.txt and share links.
# Without it, metadata falls back to https://balu.tools.
NEXT_PUBLIC_SITE_URL=https://101plus.vercel.app

# ── AI provider ──────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint works: OpenAI, Groq, Together, OpenRouter,
# Ollama, LM Studio, vLLM. Setting AI_API_KEY enables all 12 AI tools.
#
# AI_PROVIDER=openai-compatible
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# Text-to-image. Powers AI Image Generator.
# AI_IMAGE_MODEL=gpt-image-1
#
# Image editing: AI Background Remover, AI Background Generator, AI Image
# Enhancer and AI Image Upscaler. Many providers use a DIFFERENT model id for
# editing than for generation, so this is separate. If it is unset the app
# falls back to AI_IMAGE_MODEL, which is right when one model does both.
#
# On xkiro the two are genuinely different, and the gateway says so:
#   AI_IMAGE_MODEL=sensenova/sensenova-u1.5-lite   generates
#   AI_EDIT_MODEL=openai/gpt-image-2.5             edits
# Sending the generation model to /v1/images/edits gives:
#   'Image editing is not available for model "sensenova/sensenova-u1.5-lite".
#    Models that support editing: openai/gpt-image-2.5.'
#
# AI_EDIT_MODEL=  */

# ── Server-dependent tools ───────────────────────────────────────────────────
# PDF encrypt / decrypt. Implemented by YOUR endpoint at
#   POST /api/tools/pdf/encrypt  and  POST /api/tools/pdf/decrypt
# PDF_ENCRYPTION_API_KEY=

# Speech-to-text. Implemented by YOUR endpoint at
#   POST /api/tools/audio/transcribe
# TRANSCRIPTION_API_KEY=

# ── Submissions ──────────────────────────────────────────────────────────────
# Tool requests and contact messages. Without these they are validated and
# accepted but held in memory, and lost on restart.
#
# TOOL_REQUESTS_ENDPOINT=https://your-service.example
# TOOL_REQUESTS_TOKEN=
# CONTACT_FORM_ENDPOINT=https://your-service.example/contact
# CONTACT_FORM_TOKEN=

# ── Admin access ─────────────────────────────────────────────────────────────
# /admin is COMPLETELY CLOSED until one of these is set. There is no default
# password, so a fresh clone cannot be brute-forced.
#
# ADMIN_SECRET=          # bearer token / cookie must match
# AUTH_SECRET=           # enables signed session cookies

# ── Persistence ──────────────────────────────────────────────────────────────
# Contact messages and tool requests. Without this they are held in memory and
# lost when the server restarts, and the forms say so.
#
# Any MongoDB works, including a free Atlas cluster. The database and the two
# collections are created automatically on first write — you do not need to make
# them by hand.
#
# The user needs readWrite on the database named in the path. On Atlas, add the
# deployment's addresses to Network Access: Vercel egresses from a wide, changing
# range, so either allow 0.0.0.0/0 or pin static egress IPs first, or the app
# will connect fine locally and fail in production.
#
# This value is a CREDENTIAL. Never commit it, and rotate it if it is ever
# pasted into a chat, a ticket or a screenshot.
#
# DATABASE_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/101plus

# ── Payments ─────────────────────────────────────────────────────────────────
# Plans and entitlement checks are implemented; the provider adapter is not.
# Checkout refuses with `not_configured` until a provider is registered.
#
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Analytics ────────────────────────────────────────────────────────────────
# OFF unless set. Receives toolId → open-count pairs. No identifiers, no
# filenames, no input content, no cookies.
#
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# ── Social links (placeholders until you set them) ──────────────────────────
# NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/your-org/balu-tools
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://youtube.com/@yourchannel
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourhandle
# NEXT_PUBLIC_SOCIAL_X=https://x.com/yourhandle
# NEXT_PUBLIC_CONTACT_EMAIL=steveharringtone999@gmail.com

# ── Email delivery ───────────────────────────────────────────────────────────
# Without these, the contact form and the tool-request form accept submissions
# but have nowhere to send them: they are held in memory and lost on restart,
# and the page says so. Setting these is what makes a message actually arrive.
#
# Uses Resend's HTTP API, called directly — no SDK, no extra dependency.
#   1. Create an account at resend.com and verify a sending domain, or use the
#      onboarding address they give you (onboarding@resend.dev).
#   2. Put the API key in RESEND_API_KEY.
#   3. MAIL_FROM must be a sender Resend has verified, including the name.
#
# Free tier: 3,000 emails a month, 100 a day.
#
# RESEND_API_KEY=
# MAIL_FROM=Balu Tools <on@yourdomain.com>
#
# Where mail is delivered. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
# MAIL_TO=steveharringtone999@gmail.com

# ── Advanced ─────────────────────────────────────────────────────────────────
# Sets Cross-Origin-Opener-Policy / Embedder-Policy headers, which ffmpeg.wasm
# needs for SharedArrayBuffer. Only enable if you deploy such a tool — the
# headers break cross-origin embeds everywhere else.
#
# NEXT_PUBLIC_CROSS_ORIGIN_ISOLATED=false
