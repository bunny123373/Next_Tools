# Normalise line endings so the same content produces the same blob on every
# platform. Without this, a Windows checkout commits CRLF and a Linux CI
# checkout commits LF for identical files, which makes diffs unreadable.
* text=auto eol=lf

# Binary assets — must never be line-ending translated
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.pdf binary
*.zip binary
